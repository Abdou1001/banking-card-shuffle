{
  "expo": {
    "name": "تحدي باي",
    "slug": "tahadi-pay",
    "scheme": "tahadipay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "ExpoLocalization_supportsRTL": true
      }
    },
    "android": {
      "package": "com.abdulrahman1001.tahadipay",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 400,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "imageWidth": 400,
            "resizeMode": "contain",
            "backgroundColor": "#FFFFFF"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2279c0f3-489f-4eab-bc45-2a986c071213"
      }
    }
  }
}